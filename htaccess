# ═══════════════════════════════════════════════════════
#  VisionX Repairs — Apache .htaccess
# ═══════════════════════════════════════════════════════

Options -Indexes
Options +FollowSymLinks
RewriteEngine On

# ═══════════════════════════════════════════════════════
#  1. PASS THROUGH admin/api/* COMPLETELY — MUST BE FIRST
#     Stops ALL further rules for API endpoints so POST
#     requests are never redirected (redirect = method loss)
# ═══════════════════════════════════════════════════════

RewriteRule ^admin/api/ - [L,NC]

# ═══════════════════════════════════════════════════════
#  2. FORCE HTTPS
# ═══════════════════════════════════════════════════════

RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── Uncomment to force non-www ───────────────────────────
# RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
# RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# ═══════════════════════════════════════════════════════
#  3. HIDE .HTML EXTENSION
# ═══════════════════════════════════════════════════════

# Redirect /page.html → /page
RewriteCond %{THE_REQUEST} \s/(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# Serve .html for clean URL
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# ═══════════════════════════════════════════════════════
#  4. HIDE .PHP EXTENSION  (api/* already handled above)
# ═══════════════════════════════════════════════════════

# Redirect /page.php → /page
RewriteCond %{THE_REQUEST} \s/(.+)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# Serve .php for clean URL
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# ═══════════════════════════════════════════════════════
#  5. CLEAN SUBDIRECTORY INDEX URLS
#     /area/westlands  →  serves  /area/westlands/index.html
# ═══════════════════════════════════════════════════════

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}/index.php -f
RewriteRule ^(.+?)/?$ $1/index.php [L]

# ═══════════════════════════════════════════════════════
#  6. BLOCK SENSITIVE FILES
# ═══════════════════════════════════════════════════════

<FilesMatch "\.sql$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

<FilesMatch "^db\.php$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

<FilesMatch "^\.">
    Order Allow,Deny
    Deny from all
</FilesMatch>

<FilesMatch "\.(bak|config|dist|inc|ini|log|sh|swp|env)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Block WordPress probing
RewriteCond %{REQUEST_URI} ^/wp-login\.php [NC]
RewriteRule ^ - [F,L]
RewriteCond %{REQUEST_URI} ^/wp-admin [NC]
RewriteRule ^ - [F,L]

# ═══════════════════════════════════════════════════════
#  7. SECURITY HEADERS
# ═══════════════════════════════════════════════════════

<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header unset Server
    Header always unset X-Powered-By
</IfModule>

ServerSignature Off

# ═══════════════════════════════════════════════════════
#  8. GZIP COMPRESSION
# ═══════════════════════════════════════════════════════

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml text/plain text/xml
</IfModule>

# ═══════════════════════════════════════════════════════
#  9. BROWSER CACHING
# ═══════════════════════════════════════════════════════

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 1 month"
    ExpiresByType application/javascript  "access plus 1 month"
    ExpiresByType text/javascript         "access plus 1 month"
    ExpiresByType image/jpeg              "access plus 3 months"
    ExpiresByType image/png               "access plus 3 months"
    ExpiresByType image/webp              "access plus 3 months"
    ExpiresByType image/svg+xml           "access plus 3 months"
    ExpiresByType image/x-icon            "access plus 3 months"
    ExpiresByType font/woff2              "access plus 3 months"
    ExpiresByType text/html               "access plus 0 seconds"
    ExpiresByType application/x-httpd-php "access plus 0 seconds"
</IfModule>

# ═══════════════════════════════════════════════════════
#  10. CUSTOM ERROR PAGES
# ═══════════════════════════════════════════════════════

ErrorDocument 404 /404.html
ErrorDocument 403 /403.html
ErrorDocument 500 /500.html
